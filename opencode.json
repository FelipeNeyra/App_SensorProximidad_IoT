{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    },
    "firebase": {
      "type": "local",
      "command": [
        "firebase",
        "mcp"
      ],
      "enabled": true
    }
  }
}
